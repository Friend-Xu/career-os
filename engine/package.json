{
  "name": "career-os-engine",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Career OS 本地引擎（纯 Node 服务，零依赖，Node 24 原生 TS type-stripping）",
  "scripts": {
    "engine": "node ../scripts/engine.mjs start",
    "engine:stop": "node ../scripts/engine.mjs stop",
    "engine:status": "node ../scripts/engine.mjs status",
    "typecheck": "tsc --noEmit",
    "sanitize": "node ../scripts/sanitize-check.mjs",
    "pretest": "node ../scripts/sanitize-check.mjs",
    "test": "node --test --test-isolation=none \"tests/*.test.ts\"",
    "smoke:bridge": "node tests/bridge-smoke.mjs",
    "smoke:proposal": "node tests/proposal-e2e.mjs",
    "smoke:handlers": "node tests/handlers-smoke.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.41",
    "@ai-sdk/deepseek": "^3.0.31",
    "@ai-sdk/google": "^4.0.50",
    "@ai-sdk/mcp": "^2.0.36",
    "@ai-sdk/openai": "^4.0.46",
    "@types/better-sqlite3": "^9.6.0",
    "@types/ws": "^8.18.1",
    "ai": "^7.0.77",
    "better-sqlite3": "^13.0.2",
    "chokidar": "^5.0.0",
    "ws": "^8.21.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^5.9.3"
  }
}
